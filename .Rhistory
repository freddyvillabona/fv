library(sf)
library(dplyr)
library(ggplot2)
library(ggrepel)
# 1. Calcular el centro de cada isla usando la columna NUT3_NOM
etiquetas_islas <- canarias %>%
filter(!is.na(NUT3_NOM)) %>%
group_by(NUT3_NOM) %>%
summarise(geometry = st_union(geometry)) %>%
st_point_on_surface()
# 2. Dibujar el mapa con los nombres de las islas
ggplot(data = canarias) +
labs(
title = "Altura media del matorral en Canarias",
subtitle = "Mapa Forestal de España (MFE25, MITECO)",
x = "",
y = "",
fill = "Altura (m)"
) +
geom_sf(aes(fill = HMMAT / 10), color = NA) +
scale_fill_viridis_c(direction = -1, end = 0.92) +
geom_text_repel(
data = etiquetas_islas,
aes(label = NUT3_NOM, geometry = geometry),
stat = "sf_coordinates",
size = 3.2,
fontface = "bold",
color = "grey20",
bg.color = "white",      # Halo blanco suave para máxima legibilidad
bg.r = 0.15,
box.padding = 0.6,
min.segment.length = 0.2,
segment.color = "grey50",
segment.size = 0.3
) +
theme(
plot.title = element_text(size = 16, face = "bold"),
plot.subtitle = element_text(size = 12),
panel.background = element_rect(fill = "white", colour = NA),
plot.background = element_rect(fill = "white", colour = NA),
legend.background = element_rect(fill = "white", colour = NA)
)
setwd("~/Desktop/canarias")
