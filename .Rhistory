{
library('sf')
library("ggplot2")
library("dplyr")
library("stringr")
}
canarias <- read_sf('MFE_70.shp')
canarias <- canarias %>%
st_as_sf()
A <- ggplot(data = canarias) +
ggtitle("Capas shapefile Canarias (2026)") +
xlab("") +
ylab("") +
geom_sf(aes(fill = HMMAT/10, color = NA), color = NA, show.legend = TRUE) +
scale_fill_viridis_c(alpha = 1,
direction = -1
) +
theme(
plot.title = element_text(size = 16),
plot.subtitle = element_text(size = 20),
panel.background = element_rect(fill = "white", colour = NA),
plot.background = element_rect(fill = "white", colour = NA),
legend.background = element_rect(fill = "white", colour = NA),
) +
labs(fill = "HMMAT  (metros)")
A
