#A
setwd("~/Desktop/eeuu")
library(ggplot2)
# 1. Obtener los datos del mapa de los estados continentales
usa_data <- map_data("state")
# 2. Graficar con ggplot2
ggplot(data = usa_data, aes(x = long, y = lat, group = group, fill = region)) +
geom_polygon(color = "white", linewidth = 0.2) +
coord_quickmap() +
guides(fill = "none") + # Oculta la leyenda de colores si no mapeas datos numéricos
theme_minimal() +
labs(
title = "Mapa de Estados Unidos con ggplot2",
x = "Longitud",
y = "Latitud"
)
View(usa_data)
View(usa_data)
library(ggplot2)
library(dplyr)
# Data frame simulado con la tendencia de los resultados de ayer (Elecciones 2026)
votos_ayer <- data.frame(
region = c("alabama", "alaska", "arizona", "arkansas", "california", "colorado",
"connecticut", "delaware", "florida", "georgia", "hawaii", "idaho",
"illinois", "indiana", "iowa", "kansas", "kentucky", "louisiana",
"maine", "maryland", "massachusetts", "michigan", "minnesota",
"mississippi", "missouri", "montana", "nebraska", "nevada",
"new hampshire", "new jersey", "new mexico", "new york",
"north carolina", "north dakota", "ohio", "oklahoma", "oregon",
"pennsylvania", "rhode island", "south carolina", "south dakota",
"tennessee", "texas", "utah", "vermont", "virginia", "washington",
"west virginia", "wisconsin", "wyoming"),
partido_ganador = c("Republicano", "Demócrata", "Demócrata", "Republicano", "Demócrata", "Demócrata",
"Demócrata", "Demócrata", "Republicano", "Demócrata", "Demócrata", "Republicano",
"Demócrata", "Republicano", "Republicano", "Republicano", "Republicano", "Republicano",
"Demócrata", "Demócrata", "Demócrata", "Demócrata", "Demócrata", "Republicano",
"Republicano", "Demócrata", "Republicano", "Demócrata", "Demócrata", "Demócrata",
"Demócrata", "Demócrata", "Demócrata", "Republicano", "Demócrata", "Republicano",
"Demócrata", "Demócrata", "Demócrata", "Republicano", "Republicano", "Republicano",
"Demócrata", "Republicano", "Demócrata", "Demócrata", "Demócrata", "Republicano",
"Demócrata", "Republicano"),
porcentaje_ganador = c(62.1, 51.3, 53.4, 60.2, 64.5, 56.8,
59.1, 58.4, 54.2, 51.5, 66.2, 63.1,
58.9, 56.4, 52.1, 54.3, 61.2, 59.8,
55.6, 62.3, 65.7, 53.1, 54.8, 51.2,
57.4, 50.8, 55.3, 52.4, 53.9, 57.2,
55.1, 61.4, 51.9, 64.2, 52.6, 63.5, 59.9,
54.1, 61.1, 56.7, 62.9, 61.8, 50.9, 60.1,
68.4, 54.6, 59.2, 65.1, 52.5, 67.8)
)
# 1. Obtener las coordenadas geográficas de los estados de EE.UU.
mapa_eeuu <- map_data("state")
# 2. Unir los resultados de ayer con las coordenadas geográficas
mapa_final <- left_join(mapa_eeuu, votos_ayer, by = "region")
# 3. Graficar el mapa electoral con ggplot2
ggplot(data = mapa_final, aes(x = long, y = lat, group = group, fill = partido_ganador)) +
geom_polygon(color = "white", linewidth = 0.3) +
scale_fill_manual(values = c("Demócrata" = "#244999", "Republicano" = "#D22532")) +
coord_quickmap() +
theme_void() +  # Remueve ejes, cuadrículas y fondos para dejar solo el mapa
labs(
title = "Mapa Electoral de los Estados Unidos",
subtitle = "Tendencia de las Elecciones Intermedias (Noviembre 2026)",
fill = "Partido Ganador"
) +
theme(
plot.title = element_text(face = "bold", size = 16, hjust = 0.5),
plot.subtitle = element_text(size = 11, hjust = 0.5, face = "italic"),
legend.position = "bottom"
)
